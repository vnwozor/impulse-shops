{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://impulse-shops-api-oncode.vercel.app/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://impulse-shops-api-oncode.vercel.app/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
